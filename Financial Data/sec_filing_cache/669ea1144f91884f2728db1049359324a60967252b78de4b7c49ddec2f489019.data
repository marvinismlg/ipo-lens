<TD VALIGN="bottom" COLSPAN="2" ALIGN="center" STYLE="border-bottom:1.00pt solid #000000"><B>Tier&nbsp;1&nbsp;and&nbsp;2<BR>cities </B></TD>
<TD VALIGN="bottom">&nbsp;</TD>
